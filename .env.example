# OctoFi Staking Environment Variables

# Somnia Testnet Configuration
VITE_SOMNIA_RPC_URL=https://testnet.rpc.somnia.network
VITE_SOMNIA_CHAIN_ID=997
VITE_SOMNIA_EXPLORER=https://testnet.explorer.somnia.network

# Staking Pool Contract Addresses (Replace with actual deployed contracts)
VITE_USDC_POOL_ADDRESS=0x1234567890123456789012345678901234567890
VITE_USDT_POOL_ADDRESS=0x2345678901234567890123456789012345678901
VITE_ARB_POOL_ADDRESS=0x3456789012345678901234567890123456789012

# Token Contract Addresses (Replace with actual token addresses)
VITE_USDC_ADDRESS=0x0987654321098765432109876543210987654321
VITE_USDT_ADDRESS=0x1987654321098765432109876543210987654321
VITE_ARB_ADDRESS=0x2987654321098765432109876543210987654321

# Optional: AI Prediction Service (Vertex AI)
# Uncomment and configure if using real AI predictions
# VITE_VERTEX_AI_PROJECT_ID=your-project-id
# VITE_VERTEX_AI_LOCATION=us-central1
# VITE_VERTEX_AI_API_KEY=your-api-key

# Optional: DIA Oracle Configuration
# Uncomment if using DIA Oracle for price feeds
# VITE_DIA_ORACLE_URL=https://api.diadata.org
# VITE_DIA_ORACLE_API_KEY=your-api-key

# Optional: Analytics and Monitoring
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_GA_TRACKING_ID=your-google-analytics-id
